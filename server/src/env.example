# ID da Página de Facebook da HST Plus (Configurações da Página > Sobre)
FB_PAGE_ID=

# Token de acesso de longa duração da Página (ver instruções no README do server/)
FB_PAGE_ACCESS_TOKEN=

# ID da conta Instagram Business associada à Página (via Graph API Explorer)
IG_BUSINESS_ACCOUNT_ID=

# Versão da Graph API a usar
META_GRAPH_VERSION=v20.0

# Quantas publicações manter na cache/mostrar no site
MAX_POSTS=9

# Porta onde o servidor Express corre
PORT=4000

# Origens autorizadas a chamar a API a partir do browser (CORS), separadas
# por vírgula. Por omissão já cobre o site em produção e o dev local — só
# precisas de definir isto se usares outro domínio (ex: staging).
# CORS_ORIGIN=https://www.hstplus.co.mz,https://hstplus.co.mz,http://localhost:5173

# Frequência de actualização da cache (formato cron). Por omissão: a cada 6 horas.
CRON_SCHEDULE=0 */6 * * *

# Chave simples para consultar GET /api/leads?key=... (pedidos de Informações/Cotação
# enviados pelo site), actualizar PUT /api/kpis?key=... (números da secção Stats da
# homepage) e PUT /api/calendario?key=... (turmas do calendário de formações).
# Define algo só teu/da equipa, ex: uma frase longa aleatória.
ADMIN_KEY=

# ── Notificação por email dos leads (Pedir Informações / Pedir Cotação) ──
#
# Sem isto configurado, os leads continuam a ser gravados normalmente em
# server/cache/leads.json — só não chega email a ninguém. Assim que estas
# variáveis estiverem definidas, cada novo lead dispara um email automático.
#
# Funciona com qualquer fornecedor SMTP. Três opções comuns:
#
# 1) Gmail — usa uma "App Password" (não a password normal da conta):
#    https://myaccount.google.com/apppasswords
#    SMTP_HOST=smtp.gmail.com / SMTP_PORT=587
#
# 2) Resend (grátis até 3000 emails/mês, fácil de configurar):
#    https://resend.com/docs/send-with-smtp
#    SMTP_HOST=smtp.resend.com / SMTP_PORT=587 / SMTP_USER=resend
#
# 3) SendGrid:
#    SMTP_HOST=smtp.sendgrid.net / SMTP_PORT=587 / SMTP_USER=apikey

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email que aparece como remetente (normalmente igual a SMTP_USER)
SMTP_FROM=

# Para onde os leads são enviados — pode ser uma lista separada por vírgulas
# se o nodemailer/o fornecedor suportar (ex: "a@hstplus.co.mz,b@hstplus.co.mz")
LEADS_NOTIFY_TO=

# Para onde vão os avisos de erro grave do servidor (excepções não apanhadas,
# rotas que rebentam). Se deixares vazio, usa o mesmo destinatário de
# LEADS_NOTIFY_TO — só precisas de preencher se quiseres separar os dois.
ALERTS_NOTIFY_TO=
